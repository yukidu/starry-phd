{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "starry-phd",
  "main": "worker.ts",
  "compatibility_date": "2026-10-15",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/*"]
  },
  "routes": [
    {
      "pattern": "starry.phd",
      "custom_domain": true
    }
  ]
}